# Vita-Web — variables de entorno.
#
# Copiar a `.env.local` (raíz del repo, symlinkeado en apps/web/) y
# completar con valores reales. NUNCA commitear `.env.local` ni pegar
# secretos reales en este archivo — ver root CLAUDE.md, seccion "Infra".

# --- Supabase (proyecto VitaAPP-WEB) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role - bypassa RLS por completo. Solo usado server-side por
# lib/supabase/admin.ts (detector de dosis vencidas y su cron route).
# NUNCA exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (chat con vita, extraccion de estudios medicos) -------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Voz (transcripcion y sintesis, lib/voz/nucleo.ts) ---------------------
GROQ_API_KEY=your-groq-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# --- Modo Cuidador: alertas de dosis vencida (lib/notificaciones/nucleo.ts) -
RESEND_API_KEY=your-resend-api-key
# Compartido entre Netlify (esta app) y la migracion de Supabase Cron
# (supabase/migrations/009_cron_dosis_vencidas.sql) - el cron POSTea este
# valor en el header `x-cron-secret`. Cualquier string largo y aleatorio.
CRON_SECRET=a-long-random-string-shared-with-the-cron-job
