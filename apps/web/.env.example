# Vita-Web — variables de entorno.
#
# Copiar a `.env.local` (raíz del repo, symlinkeado en apps/web/) y
# completar con valores reales. NUNCA commitear `.env.local` ni pegar
# secretos reales en este archivo — ver root CLAUDE.md, seccion "Infra".

# --- Supabase (proyecto VitaAPP-WEB) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role - bypassa RLS por completo. Solo usado server-side por
# lib/supabase/admin.ts (detector de dosis vencidas y su cron route).
# NUNCA exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (chat con vita, extraccion de estudios medicos) -------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Voz (transcripcion y sintesis, lib/voz/nucleo.ts) ---------------------
GROQ_API_KEY=your-groq-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# --- Modo Cuidador: alertas de dosis vencida (lib/notificaciones/nucleo.ts) -
RESEND_API_KEY=your-resend-api-key
# Compartido entre Netlify (esta app) y la migracion de Supabase Cron
# (supabase/migrations/009_cron_dosis_vencidas.sql) - el cron POSTea este
# valor en el header `x-cron-secret`. Cualquier string largo y aleatorio.
CRON_SECRET=a-long-random-string-shared-with-the-cron-job
# Opcional: secreto para hashear la IP en el throttling de codigos
# (lib/acceso-codigo). Si falta se usa CRON_SECRET o la service role key.
CODIGOS_IP_SECRET=another-long-random-string

# --- Web Push (lib/notificaciones/push.ts, public/sw.js) --------------------
# Generar el par con `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- Email transaccional por SMTP (lib/email/smtp.ts) ----------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="vita <no-reply@example.com>"

# --- vita+ con Mercado Pago (lib/vita-plus, app/api/vita-plus, app/api/mercadopago/webhook) ---
# Aplicacion de Mercado Pago PROPIA de vita (no compartir credenciales con otros proyectos). Sin MP_ACCESS_TOKEN la
# pantalla de vita+ sigue mostrando "Muy pronto" (el deploy no se rompe). El webhook a registrar en el panel de MP es
# https://<sitio>/api/mercadopago/webhook con los eventos "subscription_preapproval" y "subscription_authorized_payment".
# La URL de retorno usa NEXT_PUBLIC_SITE_URL (https obligatorio, http solo en localhost).
MP_ACCESS_TOKEN=your-mercado-pago-access-token
# Clave secreta de firma de los webhooks (panel de MP > tu aplicacion > Webhooks).
MP_WEBHOOK_SECRET=your-mercado-pago-webhook-signature-secret

# --- Sitio ------------------------------------------------------------------
# Origen publico para armar links (enlaces para profesionales, emails).
# Si falta se usan los headers de la request.
NEXT_PUBLIC_SITE_URL=https://vitappweb.netlify.app
# Solo local/pruebas: habilita el login con email y contrasena y las
# vistas previas de /dev. Nunca en produccion.
NEXT_PUBLIC_ENABLE_TEST_LOGIN=false

# --- Panel de administracion (/adminvita) -------------------------------------
# Emails de los administradores, separados por comas (se comparan sin importar mayusculas). Solo ellos ven el panel;
# cualquier otra persona recibe un 404. Vacio o ausente = nadie es admin. El email debe estar confirmado en Auth.
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com
# Segundo factor del panel: secreto para firmar la cookie de verificacion (HMAC-SHA256) y hashear los codigos de 6
# digitos. Minimo 32 caracteres, aleatorio (por ejemplo `openssl rand -base64 48`). Si falta o es corto, NADIE puede
# completar la verificacion y el panel queda cerrado. El codigo se envia por SMTP al email de la sesion de Google.
ADMIN_SESSION_SECRET=
# Clave (HMAC-SHA256) con la que se guardan los hashes de los codigos promocionales de vita+. Aleatoria y larga
# (por ejemplo `openssl rand -base64 48`). Si falta se usa SUPABASE_SERVICE_ROLE_KEY. Tiene que ser ESTABLE: rotarla
# invalida todos los codigos que todavia no se canjearon.
VITA_PLUS_CODIGOS_SECRET=
